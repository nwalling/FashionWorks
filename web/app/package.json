{
  "name": "@fashionworks/web",
  "private": false,
  "version": "0.3.1",
  "type": "module",
  "description": "Browse and combine Star Citizen FPS armour, entirely in the visitor's browser, from their own Data.p4k.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "verify": "vite --port 5183",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/check-package.mjs",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check": "npm run typecheck && npm run lint:css && npm run test"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stylelint": "^16.26.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "@types/three": "^0.169.0",
    "three": "^0.169.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/fashionworks.cjs",
  "module": "./dist/fashionworks.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fashionworks.js",
      "require": "./dist/fashionworks.cjs"
    },
    "./style.css": "./dist/fashionworks.css"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "sideEffects": [
    "*.css"
  ]
}
