+/// An eight-influence bone map, as `IVOBONEMAP32` stores it.
+///
+/// 24 bytes: eight `u16` joint indices followed by eight `u8` weights. The
+/// weights sum to 255. Worked out from the bytes rather than from
+/// documentation -- the sum is what confirms the split, since no other reading
+/// of 24 bytes makes four consecutive records total exactly 255.
+///
+/// This is the format armour actually uses, and upstream skips it, which is why
+/// a StarBreaker GLB of an armour mesh comes out rigid.
+#[derive(Debug, Clone, Copy)]
+pub struct BoneMap32 {
+    pub joint_indices: [u16; 8],
+    pub weights: [u8; 8],
+}
+
+impl BoneMap32 {
+    /// Influences with a non-zero weight, as (joint, weight).
+    pub fn influences(&self) -> impl Iterator<Item = (u16, u8)> + '_ {
+        self.joint_indices
+            .iter()
+            .copied()
+            .zip(self.weights.iter().copied())
+            .filter(|(_, w)| *w > 0)
+    }
+}
+
