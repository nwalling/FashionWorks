diff --git a/crates/starbreaker-chf/tests/hostile_test.rs b/crates/starbreaker-chf/tests/hostile_test.rs
new file mode 100644
index 0000000..d316bac
--- /dev/null
+++ b/crates/starbreaker-chf/tests/hostile_test.rs
@@ -0,0 +1,45 @@
+//! A `.chf` is a file people share, so a malformed one must be an error, not
+//! a panic: under `panic = "abort"` a panic kills the whole WebAssembly worker.
+
+use starbreaker_chf::{ChfFile, ItemPort};
+use starbreaker_common::SpanReader;
+
+/// A 4,096-byte container with a valid header and CRC over `payload`.
+fn container(compressed_size: u32, payload: &[u8]) -> Vec<u8> {
+    let mut bytes = vec![0u8; 4096];
+    bytes[0..2].copy_from_slice(&0x4242u16.to_le_bytes());
+    bytes[8..12].copy_from_slice(&compressed_size.to_le_bytes());
+    bytes[16..16 + payload.len()].copy_from_slice(payload);
+    let crc = crc32c::crc32c(&bytes[16..4096]);
+    bytes[4..8].copy_from_slice(&crc.to_le_bytes());
+    bytes
+}
+
+#[test]
+fn compressed_size_past_the_container_is_an_error() {
+    for size in [4081, 10_000, u32::MAX] {
+        assert!(ChfFile::from_chf(&container(size, &[])).is_err(), "size {size}");
+    }
+}
+
+/// One item-port node: name hash, GUID, child count, tail count.
+fn node(children: u32) -> Vec<u8> {
+    let mut out = vec![0u8; 4 + 16];
+    out.extend_from_slice(&children.to_le_bytes());
+    out.extend_from_slice(&0u32.to_le_bytes());
+    out
+}
+
+#[test]
+fn a_huge_child_count_is_an_error_not_an_allocation() {
+    let bytes = node(u32::MAX);
+    let mut reader = SpanReader::new(&bytes);
+    assert!(ItemPort::read(&mut reader).is_err());
+}
+
+#[test]
+fn nesting_past_the_limit_is_an_error_not_a_stack_overflow() {
+    let bytes: Vec<u8> = (0..100_000).flat_map(|_| node(1)).collect();
+    let mut reader = SpanReader::new(&bytes);
+    assert!(ItemPort::read(&mut reader).is_err());
+}
