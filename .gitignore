# Extracted / generated game data — never committed (CIG copyright, see CLAUDE.md)
/data/
!/data/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / viewer
node_modules/
/viewer/dist/
/viewer/public/assets
*.tsbuildinfo

# Extraction tools: sources are cloned and binaries built by tools/build.sh.
# The script itself is tracked; nothing it produces is.
/tools/src/
/tools/bin/
# Rust build output for the anim-dump shim; the source and lockfile are tracked.
/tools/anim-dump/target/

# OS
.DS_Store

# Machine-specific overrides
config/settings.local.toml

# Scratch pages used to eyeball generated textures
/viewer/public/_*/

# Generated wasm bindings for the Phase 0 spike; web/spike/build.sh makes them.
web/spike/pkg/
web/spike/pkg-web/
